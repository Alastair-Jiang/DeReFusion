# Phase 1 handoff inputs and receipts are hashed as raw bytes.  Keep Git from
# rewriting them on Windows or when source archives are produced.
reproduction/handoff/phase1_outsourcing/** -text
reproduction/results/phase1/**/*.json -text
reproduction/results/phase1/**/*.csv -text
# run.log is the only textual member of a calibration receipt's sealed set
# (pred/true/metrics are .npy, the checkpoint is .pth, both binary and left
# alone by Git).  Without this rule core.autocrlf=true stores LF in the blob
# while the receipt hashes the CRLF working-tree bytes, so every receipt fails
# verification on a Linux checkout.
reproduction/results/phase1/**/*.log -text
reproduction/logs/phase1/**/*.log -text
docs/PHASE1_OUTSOURCING_EXECUTION_PLAN.md -text

# Shell scripts are executed on the Linux worker, so their line endings are
# load-bearing: a CRLF shebang fails with ": command not found".
*.sh text eol=lf

# The management package manifest seals raw file bytes; preserve those bytes
# across Git checkout and source archive creation on Windows.
